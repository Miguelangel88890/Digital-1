P_0x3aeb3b90 .param/l "OFFSET" 0 3 15, +C4<00000000000000000000000000000000>;
P_0x3aeb3bd0 .param/l "PERIOD" 0 3 13, +C4<00000000000000000000000000010100>;
v0x3aef0660_0 .net "A", 31 0, v0x3aec7cf0_0;  1 drivers
v0x3aef0740_0 .var "clk", 0 0;
v0x3aef07e0_0 .var "count", 0 0;
v0x3aef08e0_0 .var "i", 2 0;
v0x3aef0980_0 .var "rst", 0 0;
