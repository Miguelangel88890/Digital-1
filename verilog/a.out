S_0x3aec9d50 .scope begin, "TEST_CASE" "TEST_CASE" 3 46, 3 46 0, S_0x3aedd380;
 .timescale -9 -12;
S_0x3aec9ee0 .scope module, "uut" "contador" 3 11, 4 1 0, S_0x3aedd380;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /OUTPUT 32 "A";
    .port_info 2 /INPUT 1 "count";
    .port_info 3 /INPUT 1 "rst";
v0x3aec7cf0_0 .var "A", 31 0;
v0x3aec7eb0_0 .net "clk", 0 0, v0x3aef0740_0;  1 drivers
v0x3aec8200_0 .net "count", 0 0, v0x3aef07e0_0;  1 drivers
v0x3aec8410_0 .net "rst", 0 0, v0x3aef0980_0;  1 drivers
E_0x3aeddd10 .event negedge, v0x3aec7eb0_0;
    .scope S_0x3aec9ee0;
T_0 ;
    %wait E_0x3aeddd10;
    %load/vec4 v0x3aec8410_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x3aec7cf0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x3aec8200_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x3aec7cf0_0;
    %addi 1, 0, 32;
    %assign/vec4 v0x3aec7cf0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x3aec7cf0_0;
    %assign/vec4 v0x3aec7cf0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x3aedd380;
T_1 ;
    %delay 0, 0;
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x3aef0740_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x3aef0740_0, 0, 1;
    %delay 10000, 0;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x3aedd380;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x3aef0980_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x3aef07e0_0, 0, 1;
    %end;
    .thread T_2;
    .scope S_0x3aedd380;
T_3 ;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x3aef0980_0, 0, 1;
    %wait E_0x3aeddbb0;
    %wait E_0x3aeddd10;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x3aef0980_0, 0, 1;
    %wait E_0x3aeddbb0;
    %wait E_0x3aeddd10;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x3aef07e0_0, 0, 1;
    %pushi/vec4 0, 0, 3;
    %store/vec4 v0x3aef08e0_0, 0, 3;
T_3.0 ; Top of for-loop 
    %load/vec4 v0x3aef08e0_0;
    %pad/u 32;
    %cmpi/u 10, 0, 32;
    %jmp/0xz T_3.1, 5;
    %wait E_0x3aeddbb0;
T_3.2 ; for-loop step statement
    %load/vec4 v0x3aef08e0_0;
    %addi 1, 0, 3;
    %store/vec4 v0x3aef08e0_0, 0, 3;
    %jmp T_3.0;
T_3.1 ; for-loop exit label
    %end;
    .thread T_3;
    .scope S_0x3aedd380;
T_4 ;
    %fork t_1, S_0x3aec9d50;
    %jmp t_0;
    .scope S_0x3aec9d50;
t_1 ;
    %vpi_call/w 3 47 "$dumpfile", "contador_TB.vcd" {0 0 0};
    %vpi_call/w 3 48 "$dumpvars", 32'sb11111111111111111111111111111111, S_0x3aec9ee0 {0 0 0};
    %delay 1000000, 0;
    %vpi_call/w 3 49 "$finish" {0 0 0};
    %end;
    .scope S_0x3aedd380;
t_0 %join;
    %end;
    .thread T_4;
