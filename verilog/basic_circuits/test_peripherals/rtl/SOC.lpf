BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
LOCATE COMP    "clk" SITE "P6";
IOBUF PORT     "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25.0 MHz;
LOCATE COMP    "LEDS" SITE "T6";
IOBUF PORT     "LEDS" IO_TYPE=LVCMOS33;
LOCATE COMP    "resetn" SITE "R7";
IOBUF PORT     "resetn" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP    "TXD" SITE "N11";
IOBUF PORT     "TXD" IO_TYPE=LVCMOS33;
LOCATE COMP    "RXD" SITE "F5";
IOBUF PORT     "RXD" IO_TYPE=LVCMOS33;
    # Control de Pantalla WS2812 
LOCATE COMP    "ws2812_salida" SITE "T13";
IOBUF PORT     "ws2812_salida" IO_TYPE=LVCMOS33;
    # entrada SO del sensor
LOCATE COMP    "in_SO" SITE "C4";
IOBUF PORT     "in_SO" IO_TYPE=LVCMOS33;
    # salida clock al sensor
LOCATE COMP    "spi_clk_salida" SITE "P11";
IOBUF PORT     "spi_clk_salida" IO_TYPE=LVCMOS33;
    # salida clock al sensor
LOCATE COMP    "spi_cs_salida" SITE "M11";
IOBUF PORT     "spi_cs_salida" IO_TYPE=LVCMOS33;