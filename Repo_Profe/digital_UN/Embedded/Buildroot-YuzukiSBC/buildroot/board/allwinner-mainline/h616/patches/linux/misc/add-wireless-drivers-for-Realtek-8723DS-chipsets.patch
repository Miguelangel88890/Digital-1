+	if( halbtc8723b1ant_is_wifi_status_changed(btcoexist) ||
+		coex_dm->auto_tdma_adjust )
+		halbtc8723b1ant_run_coexist_mechanism(btcoexist);	
+
+	coex_sta->specific_pkt_period_cnt++;
+
+	/* sample to set bt to execute Ant detection */
