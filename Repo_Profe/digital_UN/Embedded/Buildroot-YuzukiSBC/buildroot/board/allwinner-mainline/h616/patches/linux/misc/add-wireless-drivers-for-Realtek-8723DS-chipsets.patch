+
+	if (pDM_Odm->SupportICType != ODM_RTL8821C)
+		return;
+
+	switch (pDM_Odm->SupportICType)
+	{
+
+	/*---------------N Series--------------------*/
+		case	ODM_RTL8188E:
+			support_ability |=
+				ODM_BB_DIG			|
