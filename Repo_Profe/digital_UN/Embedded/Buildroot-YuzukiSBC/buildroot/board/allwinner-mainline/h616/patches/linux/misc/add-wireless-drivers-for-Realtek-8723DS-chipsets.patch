+BEAMFORMING_CAP beamforming_get_entry_beam_cap_by_mac_id(void *mlme, u8 mac_id)
+{
+	PADAPTER adapter;
+	struct beamforming_info	*pBeamInfo;
+	struct beamformee_entry *bfee;
+	BEAMFORMING_CAP cap = BEAMFORMING_CAP_NONE;
+	u8 i = 0;
