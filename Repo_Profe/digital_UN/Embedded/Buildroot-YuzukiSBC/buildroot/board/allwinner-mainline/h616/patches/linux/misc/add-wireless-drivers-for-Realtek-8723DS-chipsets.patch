+	if (halbtc8821aCsr2ant_need_to_dec_bt_pwr(btcoexist))
+		halbtc8821aCsr2ant_dec_bt_pwr(btcoexist, NORMAL_EXEC, true);
+	else
+		halbtc8821aCsr2ant_dec_bt_pwr(btcoexist, NORMAL_EXEC, false);
