index 000000000..862c5971f
--- /dev/null
+++ b/drivers/net/wireless/rtl8723ds/hal/phydm/phydm_antdect.c
@@ -0,0 +1,964 @@
+/******************************************************************************
+ *
+ * Copyright(c) 2007 - 2011 Realtek Corporation. All rights reserved.
+ *                                        
