+static u8 _halmac_sdio_reg_read_8(void *p, u32 offset)
+{
+	struct dvobj_priv *d;
+	u8 *pbuf;
+	u8 val;
+	int err;
+
+
+	d = (struct dvobj_priv *)p;
+	val = SDIO_ERR_VAL8;
+	pbuf = rtw_zmalloc(1);
+	if (!pbuf)
+		return val;
+
+	err = d->intf_ops->read(d, offset, pbuf, 1, 0);
+	if (err) {
+		RTW_INFO("%s: [ERROR] I/O FAIL!\n", __FUNCTION__);
+		goto exit;
+	}
+
+	val = *pbuf;
+
+exit:
+	rtw_mfree(pbuf, 1);
+
+	return val;
+}
