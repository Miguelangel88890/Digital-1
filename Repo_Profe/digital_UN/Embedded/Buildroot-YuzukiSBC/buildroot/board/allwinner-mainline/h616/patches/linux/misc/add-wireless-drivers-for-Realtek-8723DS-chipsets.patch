+/******************************************************************************
+*                           MPCIE.TXT
+******************************************************************************/
+
+u1Byte Array_MP_8723D_MPCIE[] = {
+	0xFF,
+	0xF3,
+	0x00,
+	0x0E,
+	0x70,
+	0x00,
+	0x00,
+	0x00,
+	0x00,
+	0x00,
+	0x00,
+	0x07,
+	0xF3,
+	0xFF,
