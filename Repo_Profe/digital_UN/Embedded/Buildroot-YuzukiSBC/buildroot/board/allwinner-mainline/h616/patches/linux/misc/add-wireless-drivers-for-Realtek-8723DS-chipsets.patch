+static inline u8 _hw_port_drv2halmac(enum _hw_port hwport)
+{
+	u8 port = 0;
+
+
+	switch (hwport) {
+	case HW_PORT0:
+		port = 0;
+		break;
+	case HW_PORT1:
+		port = 1;
+		break;
+	case HW_PORT2:
+		port = 2;
+		break;
+	case HW_PORT3:
+		port = 3;
+		break;
+	case HW_PORT4:
+		port = 4;
+		break;
+	default:
+		port = hwport;
+		break;
+	}
+
+	return port;
+}
