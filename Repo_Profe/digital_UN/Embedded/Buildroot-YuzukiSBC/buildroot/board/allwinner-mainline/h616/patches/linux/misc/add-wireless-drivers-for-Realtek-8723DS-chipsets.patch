+		u1Byte regulation = Array[i];
+		u1Byte band = Array[i+1];
+		u1Byte bandwidth = Array[i+2];
+		u1Byte rate = Array[i+3];
+		u1Byte rfPath = Array[i+4];
+		u1Byte chnl = Array[i+5];
+		u1Byte val = Array[i+6];
