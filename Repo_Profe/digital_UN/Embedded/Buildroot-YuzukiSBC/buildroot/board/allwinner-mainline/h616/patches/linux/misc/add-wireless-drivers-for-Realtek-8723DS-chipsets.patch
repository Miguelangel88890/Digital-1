+	u4Byte     i           = 0;
+#if (DM_ODM_SUPPORT_TYPE == ODM_IOT)
+	u4Byte     ArrayLen    = sizeof(Array_MP_8723D_TXPWR_LMT)/sizeof(u1Byte);
+	pu1Byte    Array      = (pu1Byte)Array_MP_8723D_TXPWR_LMT;
