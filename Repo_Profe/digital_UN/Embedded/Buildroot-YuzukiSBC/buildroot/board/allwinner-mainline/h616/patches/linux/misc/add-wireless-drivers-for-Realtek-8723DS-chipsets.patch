+			rfe_type->ext_ant_switch_type = BT_8821C_1ANT_EXT_ANT_SWITCH_USE_DPDT;          /*1-Ant, Aux, DPDT, BTG   */;
+			rfe_type->wlg_Locate_at_btg = true;
