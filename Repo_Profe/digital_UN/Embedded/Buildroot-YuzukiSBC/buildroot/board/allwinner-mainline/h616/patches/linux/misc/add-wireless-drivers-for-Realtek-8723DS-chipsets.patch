+		reg_addr = 0xa8;
+		break;
+	case BT_8723D_2ANT_LBTT_BT_BREAK_LTE:
+		reg_addr = 0xac;
+		break;
+	case BT_8723D_2ANT_LBTT_LTE_BREAK_WL:
