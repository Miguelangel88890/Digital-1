+ *	01/21/2008	MHC		Create Version 0.
+ *
+ *---------------------------------------------------------------------------*/
+static	VOID
+phy_FwRFSerialWrite(
+	IN	PADAPTER			Adapter,
+	IN	RF_PATH			eRFPath,
+	IN	u32				Offset,
+	IN	u32				Data)
+{
+	/* RT_ASSERT(FALSE,("deprecate!\n")); */
