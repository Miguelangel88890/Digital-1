+	   (((regEAC_S0 & 0x03FF0000)>>16) != 0x36) &&
+	   (((regEA4_S0 & 0x03FF0000)>>16) < 0x11a) &&
+	   (((regEA4_S0 & 0x03FF0000)>>16) > 0xe6) &&
+	   (tmp < 0x1a))
+		result |= 0x02;
+	else							
+		ODM_RT_TRACE(pDM_Odm,ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("S0 RXIQK STEP2 FAIL\n"));
+
+	
+	return result;
+}
