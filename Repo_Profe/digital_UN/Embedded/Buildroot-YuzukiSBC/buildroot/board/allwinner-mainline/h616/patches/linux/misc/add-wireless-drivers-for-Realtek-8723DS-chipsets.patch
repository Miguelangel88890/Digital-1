+/*
+* rtw_scan_timeout_handler - Timeout/Faliure handler for CMD SiteSurvey
+* @adapter: pointer to _adapter structure
+*/
+void rtw_scan_timeout_handler(_adapter *adapter)
+{
+	_irqL irqL;
+	struct mlme_priv *pmlmepriv = &adapter->mlmepriv;
